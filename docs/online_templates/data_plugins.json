      "requires_location": false,
      "presets": [
        {
          "label": "1 USD to Local Currency",
          "spec": "https://api.frankfurter.dev/v1/latest?base=USD&symbols={currency}|rates.{currency}",
          "prefix": "1 USD = ",
          "suffix": ""
        },
        {
          "label": "1 EUR to Local Currency",
          "spec": "https://api.frankfurter.dev/v1/latest?base=EUR&symbols={currency}|rates.{currency}",
          "prefix": "1 EUR = ",
          "suffix": ""
        },
        {
          "label": "1 GBP to Local Currency",
          "spec": "https://api.frankfurter.dev/v1/latest?base=GBP&symbols={currency}|rates.{currency}",
          "prefix": "1 GBP = ",
          "suffix": ""
        },
        {
          "label": "1 USD to EUR (€)",
          "spec": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR|rates.EUR",
          "prefix": "€",
          "suffix": ""
        },
        {
          "label": "1 USD to INR (₹)",
          "spec": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=INR|rates.INR",
          "prefix": "₹",
          "suffix": ""
        },
        {
          "label": "1 USD to JPY (¥)",
          "spec": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=JPY|rates.JPY",
          "prefix": "¥",
          "suffix": ""
        }
      ]
    },
    {
      "id": "nager_public_holidays",
      "title": "Next Public Holiday",
