      "category": "Calendar & Culture",
      "requires_location": false,
      "presets": [
        {
          "label": "Next Public Holiday Name",
          "spec": "https://date.nager.at/api/v3/NextPublicHolidays/{country_code}|0.localName",
          "prefix": "",
          "suffix": ""
        },
        {
          "label": "Next Public Holiday Date (YYYY-MM-DD)",
          "spec": "https://date.nager.at/api/v3/NextPublicHolidays/{country_code}|0.date",
          "prefix": "",
          "suffix": ""
        }
      ]
    },
    {
      "id": "wikipedia_on_this_day",
      "title": "On This Day in History",
      "subtitle": "Historical event for today's date from Wikipedia",
      "category": "Calendar & Culture",
      "requires_location": false,
      "presets": [
        {
          "label": "Today's Historical Event Summary",
          "spec": "https://{lang}.wikipedia.org/api/rest_v1/feed/onthisday/selected/{month_2}/{day_2}|selected.0.text",
          "prefix": "",
          "suffix": ""
        },
        {
          "label": "Today's Historical Event Year",
          "spec": "https://{lang}.wikipedia.org/api/rest_v1/feed/onthisday/selected/{month_2}/{day_2}|selected.0.year",
          "prefix": "Year ",
          "suffix": ""
        }
      ]
    },
    {
      "id": "space_earth_telemetry",
      "title": "Space & Earth Observatory",
      "subtitle": "ISS orbital telemetry & USGS significant earthquake monitor",
      "category": "Space & Science",
      "requires_location": false,
      "presets": [
        {
          "label": "ISS Orbital Altitude (km)",
          "spec": "https://api.wheretheiss.at/v1/satellites/25544|altitude",
          "prefix": "ISS ",
          "suffix": " km"
        },
        {
          "label": "ISS Orbital Velocity (km/h)",
          "spec": "https://api.wheretheiss.at/v1/satellites/25544|velocity",
          "prefix": "",
          "suffix": " km/h"
        },
        {
          "label": "Latest Significant Earthquake (USGS)",
          "spec": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_month.geojson|features.0.properties.title",
          "prefix": "",
          "suffix": ""
        }
      ]
    },
    {
      "id": "daily_wisdom_facts",
      "title": "Daily Wisdom & Facts",
      "subtitle": "Stoic quotes, daily advice & verified fact of the day",
