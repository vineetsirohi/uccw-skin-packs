{
  "version": 1,
  "updated_at": "2026-10-26",
  "plugins": [
    {
      "id": "open_meteo_air_quality",
      "title": "Air Quality & UV Index",
      "subtitle": "Live US/EU AQI, UV Index, PM2.5 & PM10 for your location",
      "category": "Weather & Environment",
      "requires_location": true,
      "presets": [
        {
          "label": "US Air Quality Index (AQI)",
          "spec": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude={lat}&longitude={lon}&current=us_aqi|current.us_aqi",
          "prefix": "",
          "suffix": " AQI"
        },
        {
          "label": "European Air Quality Index (EAQI)",
          "spec": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude={lat}&longitude={lon}&current=european_aqi|current.european_aqi",
          "prefix": "",
          "suffix": " EAQI"
        },
        {
          "label": "Current UV Index",
          "spec": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude={lat}&longitude={lon}&current=uv_index|current.uv_index",
          "prefix": "UV ",
          "suffix": ""
        },
        {
          "label": "PM2.5 Fine Particles (µg/m³)",
          "spec": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude={lat}&longitude={lon}&current=pm2_5|current.pm2_5",
          "prefix": "",
          "suffix": " µg/m³"
        },
        {
          "label": "PM10 Coarse Dust (µg/m³)",
          "spec": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude={lat}&longitude={lon}&current=pm10|current.pm10",
          "prefix": "",
          "suffix": " µg/m³"
        }
      ]
    },
    {
      "id": "open_meteo_solar_atmosphere",
      "title": "Solar & Atmospheric Telemetry",
      "subtitle": "Solar irradiance, max UV, dew point, wind gusts & pressure",
      "category": "Weather & Environment",
      "requires_location": true,
      "presets": [
        {
          "label": "Solar Radiation (W/m²)",
          "spec": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=shortwave_radiation|current.shortwave_radiation",
          "prefix": "",
          "suffix": " W/m²"
        },
        {
          "label": "Daily Max UV Index",
          "spec": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&daily=uv_index_max&timezone={tz_url}|daily.uv_index_max.0",
          "prefix": "UV Max ",
          "suffix": ""
        },
        {
          "label": "Dew Point Temperature",
          "spec": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=dew_point_2m&temperature_unit={temp_unit}|current.dew_point_2m",
          "prefix": "",
          "suffix": "°"
        },
        {
          "label": "Wind Gusts",
          "spec": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=wind_gusts_10m&wind_speed_unit={speed_unit}|current.wind_gusts_10m",
          "prefix": "Gusts ",
          "suffix": ""
        },
        {
          "label": "Surface Barometric Pressure (hPa)",
          "spec": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=surface_pressure|current.surface_pressure",
          "prefix": "",
          "suffix": " hPa"
        }
      ]
    },
    {
      "id": "coingecko_crypto_ticker",
      "title": "Crypto Market Ticker",
      "subtitle": "Live Bitcoin, Ethereum, Solana & custom coin prices",
      "category": "Finance & Markets",
      "requires_location": false,
      "presets": [
        {
          "label": "Bitcoin (BTC) in Local Currency",
          "spec": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies={currency_lower}|bitcoin.{currency_lower}",
          "prefix": "BTC ",
          "suffix": ""
        },
        {
          "label": "Bitcoin (BTC) in USD ($)",
          "spec": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd|bitcoin.usd",
          "prefix": "$",
          "suffix": ""
        },
        {
          "label": "Ethereum (ETH) in Local Currency",
          "spec": "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies={currency_lower}|ethereum.{currency_lower}",
          "prefix": "ETH ",
          "suffix": ""
        },
        {
          "label": "Ethereum (ETH) in USD ($)",
          "spec": "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd|ethereum.usd",
          "prefix": "$",
          "suffix": ""
        },
        {
          "label": "Solana (SOL) in USD ($)",
          "spec": "https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd|solana.usd",
          "prefix": "$",
          "suffix": ""
        },
        {
          "label": "Custom Coin (Enter CoinGecko ID)",
          "spec": "https://api.coingecko.com/api/v3/simple/price?ids={input}&vs_currencies={currency_lower}|{input}.{currency_lower}",
          "prefix": "",
          "suffix": "",
          "input_key": "input",
          "input_label": "CoinGecko ID (e.g. dogecoin, cardano, ripple)",
          "input_default": "dogecoin"
        }
      ]
    },
    {
      "id": "frankfurter_forex_rates",
